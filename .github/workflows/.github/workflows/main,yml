name: Build Minecraft Mod on: workflow_dispatch jobs: build: runs-on: ubuntu-latest steps: - name: Checkout uses: actions/checkout@v4 - name: Set up Java uses: actions/setup-java@v4 with: distribution: temurin java-version: '21' - name: Set up Gradle uses: gradle/actions/setup-gradle@v4 - name: Extract ZIP run: unzip -o bober-client.zip -d source - name: Show project files run: find source -maxdepth 3 -type f | head -100 - name: Build Mod working-directory: source/bober-client run: gradle build --stacktrace - name: Upload JAR uses: actions/upload-artifact@v4 with: name: bober-client-jar path: source/bober-client/build/libs/*.jar
